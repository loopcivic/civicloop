// =======================
// GENERATOR
// =======================
generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

// =======================
// DATASOURCE (Prisma 7)
// =======================
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================
// ENUMS
// =======================
enum Role {
  CITIZEN
  OFFICER
  ADMIN
}

enum Category {
  ROAD
  WATER
  GARBAGE
  LIGHT
  SEWAGE
  OTHER
}

enum Status {
  CREATED
  ACKNOWLEDGED
  ASSIGNED
  INSPECTION
  WORK_IN_PROGRESS
  RESOLVED
  VERIFIED
  REOPENED
}

enum EventType {
  CREATED
  ACKNOWLEDGED
  ASSIGNED
  INSPECTION
  WORK_STARTED
  RESOLVED
  VERIFIED
  REOPENED
  ESCALATED
  DUPLICATE_FLAGGED
  DUPLICATE_LINKED
  UPVOTED
}

enum MediaKind {
  PHOTO
  VIDEO
}

enum Vote {
  CONFIRMED
  NOT_FIXED
}

enum SignalType {
  UPVOTE
  STILL_PRESENT
}

enum EntityType {
  WARD
  OFFICER
  DEPARTMENT
}

