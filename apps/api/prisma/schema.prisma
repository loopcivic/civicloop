model User {
  id        String   @id @default(uuid())
  phone     String?  @unique
  email     String?  @unique
  name      String?
  role      Role     @default(CITIZEN)
  password  String?

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())

  // ✅ NEW: Officer Details (Nullable, so it doesn't break Citizens)
  wardId       String?
  departmentId String?

  // ✅ NEW: Direct Relations to Ward & Dept
  ward         Ward?       @relation(fields: [wardId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])

  // Existing Relations
  complaints          Complaint[]       @relation("UserComplaints")
  validations         Validation[]
  
  // 🔴 COMMENT THIS OUT (We are replacing the Officer table)
  // officer          Officer?

  ComplaintSignal     ComplaintSignal[]
  
  // ✅ This is the critical link for your new Assignment logic
  assignedComplaints  Complaint[]       @relation("OfficerAssignments")
}
model VerificationToken {
  id         String   @id @default(uuid())
  identifier String   // This will store either the email OR the phone number
  token      String   // The 6-digit OTP
  expiresAt  DateTime // When the OTP expires (e.g., 5 mins from creation)
  createdAt  DateTime @default(now())

  @@unique([identifier, token]) // Ensures we can look up the exact OTP for the identifier
}
model Department {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  officers   User[]
  slas       SLA[]
  complaints Complaint[] // ✅ ADD THIS LINE
}

model Ward {
  id        String   @id @default(uuid())
  cityCode  String
  name      String
  createdAt DateTime @default(now())

  officers   User[]
  complaints Complaint[]
}

