model Complaint {
  id          String @id @default(uuid())
  createdById String
  createdBy   User   @relation("UserComplaints", fields: [createdById], references: [id])

  title       String
  description String?
  category    Category

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  wardId String
  ward   Ward   @relation(fields: [wardId], references: [id])

  // ✅ NEW: assigned officer (optional until ACK)
  assignedOfficerId String?
  //assignedOfficer   Officer? @relation(fields: [assignedOfficerId], references: [id])
  assignedOfficer   User?   @relation("OfficerAssignments", fields: [assignedOfficerId], references: [id])

  // ✅ NEW: duplicates link to canonical complaint
  duplicateOfId String?
  duplicateOf   Complaint?  @relation("DuplicateLink", fields: [duplicateOfId], references: [id])
  duplicates    Complaint[] @relation("DuplicateLink")

  lat          Float
  lng          Float
  locationText String?

  createdAt     DateTime @default(now())
  currentStatus Status   @default(CREATED)

  events      ComplaintEvent[]
  media       Media[]
  validations Validation[]
  signals     ComplaintSignal[]

  @@index([wardId, createdAt])
  @@index([departmentId, createdAt])
  @@index([assignedOfficerId, createdAt])
  @@index([duplicateOfId])
}

model ComplaintSignal {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type      SignalType
  createdAt DateTime   @default(now())

  @@unique([complaintId, userId, type])
  @@index([complaintId, createdAt])
}

model ComplaintEvent {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id])

  type        EventType
  actorUserId String?
  actorRole   Role?

  data      Json
  createdAt DateTime @default(now())

  prevHash String?
  hash     String  @unique

  @@index([complaintId, createdAt])
}

model Media {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id])

  eventId String?
  url     String
  kind    MediaKind
  sha256  String

  lat Float?
  lng Float?

  createdAt DateTime @default(now())

  @@index([complaintId, createdAt])
}

model SLA {
  id       String   @id @default(uuid())
  category Category

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  ackHours     Int
  resolveHours Int

  @@unique([category, departmentId])
}

model Validation {
  id String @id @default(uuid())

  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  vote     Vote
  note     String?
  mediaUrl String?

  createdAt DateTime @default(now())

  @@unique([complaintId, userId])
}

model PerformanceSnapshot {
  id          String     @id @default(uuid())
  entityType  EntityType
  entityId    String
  periodMonth DateTime // store first day of month

  totalIssues    Int
  ackP50Min      Int
  ackP95Min      Int
  resolveP50Min  Int
  resolveP95Min  Int
  resolutionRate Int // 0..100
  slaBreachRate  Int // 0..100

  createdAt DateTime @default(now())

  @@unique([entityType, entityId, periodMonth])
  @@index([entityType, periodMonth])
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([phone, expiresAt])
}

