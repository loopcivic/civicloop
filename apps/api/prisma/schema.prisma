// =======================
// GENERATOR
// =======================
generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

// =======================
// DATASOURCE (Prisma 7)
// =======================
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================
// ENUMS
// =======================
enum Role {
  CITIZEN
  OFFICER
  ADMIN
}

enum Category {
  ROAD
  WATER
  GARBAGE
  LIGHT
  SEWAGE
  OTHER
}

enum Status {
  CREATED
  ACKNOWLEDGED
  ASSIGNED
  INSPECTION
  WORK_IN_PROGRESS
  RESOLVED
  VERIFIED
  REOPENED
}

enum EventType {
  CREATED
  ACKNOWLEDGED
  ASSIGNED
  INSPECTION
  WORK_STARTED
  RESOLVED
  VERIFIED
  REOPENED
  ESCALATED
  DUPLICATE_FLAGGED
  DUPLICATE_LINKED
  UPVOTED
}

enum MediaKind {
  PHOTO
  VIDEO
}

enum Vote {
  CONFIRMED
  NOT_FIXED
}

// ✅ UPGRADED: Added new Issue-Specific Reactions
enum SignalType {
  UPVOTE
  STILL_PRESENT
  SAFETY_HAZARD
  TRAFFIC_BLOCKER
  BAD_SMELL
  COSTING_MONEY
}

enum EntityType {
  WARD
  OFFICER
  DEPARTMENT
}

// =======================
// MODELS
// =======================

model User {
  id        String   @id @default(uuid())
  phone     String?  @unique
  email     String?  @unique
  name      String?
  role      Role     @default(CITIZEN)
  password  String?

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())

  // Officer Details (Nullable, so it doesn't break Citizens)
  wardId       String?
  departmentId String?

  // Direct Relations to Ward & Dept
  ward         Ward?       @relation(fields: [wardId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])

  // Existing Relations
  complaints         Complaint[]       @relation("UserComplaints")
  validations        Validation[]
  
  ComplaintSignal    ComplaintSignal[]
  updates            ComplaintUpdate[]
  
  // ✅ NEW: Relation for Nudging
  nudges             Nudge[]
  
  // This is the critical link for your new Assignment logic
  assignedComplaints Complaint[]       @relation("OfficerAssignments")
}

model VerificationToken {
  id         String   @id @default(uuid())
  identifier String   // This will store either the email OR the phone number
  token      String   // The 6-digit OTP
  expiresAt  DateTime // When the OTP expires (e.g., 5 mins from creation)
  createdAt  DateTime @default(now())

  @@unique([identifier, token]) // Ensures we can look up the exact OTP for the identifier
}

model Department {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  officers   User[]
  slas       SLA[]
  complaints Complaint[] 
}

model Ward {
  id        String   @id @default(uuid())
  cityCode  String
  name      String
  createdAt DateTime @default(now())

  officers   User[]
  complaints Complaint[]
}

model Complaint {
  id          String @id @default(uuid())
  createdById String
  createdBy   User   @relation("UserComplaints", fields: [createdById], references: [id])

  title       String
  description String?
  category    Category

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  wardId String
  ward   Ward   @relation(fields: [wardId], references: [id])

  assignedOfficerId String?
  assignedOfficer   User?   @relation("OfficerAssignments", fields: [assignedOfficerId], references: [id])

  duplicateOfId String?
  duplicateOf   Complaint?  @relation("DuplicateLink", fields: [duplicateOfId], references: [id])
  duplicates    Complaint[] @relation("DuplicateLink")

  lat          Float
  lng          Float
  locationText String?

  createdAt     DateTime @default(now())
  resolvedAt     DateTime?
  currentStatus Status   @default(CREATED)

  events      ComplaintEvent[]
  media       Media[]
  validations Validation[]
  signals     ComplaintSignal[]
  updates     ComplaintUpdate[]
  
  // ✅ NEW: Relation for Nudging
  nudges      Nudge[]

  @@index([wardId, createdAt])
  @@index([departmentId, createdAt])
  @@index([assignedOfficerId, createdAt])
  @@index([duplicateOfId])
}

model ComplaintUpdate {
  id          String    @id @default(uuid())
  
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  
  text        String
  mediaUrl    String?   // Optional: If citizens upload a new photo of the progress

  // ✅ NEW: Tagging & Pinning for Chat Validation
  tag         String?   // E.g., "WORK_SPOTTED", "HAZARD"
  isPinned    Boolean   @default(false)

  createdAt   DateTime  @default(now())

  @@index([complaintId, createdAt])
}

model ComplaintSignal {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type      SignalType
  
  // ✅ NEW: Impact/Severity Slider Support (1 = Minor, 2 = Inconvenience, 3 = Danger)
  severity  Int        @default(1)

  createdAt DateTime   @default(now())

  @@unique([complaintId, userId, type])
  @@index([complaintId, createdAt])
}

// ✅ NEW: Nudge Model for the "Urge Action" feature
model Nudge {
  id          String    @id @default(uuid())
  
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())

  // A user can only nudge a specific complaint once (we will enforce 24hr cooldown in backend logic)
  @@unique([complaintId, userId])
  @@index([complaintId, createdAt])
}

model ComplaintEvent {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id])

  type        EventType
  actorUserId String?
  actorRole   Role?

  data        Json
  createdAt DateTime @default(now())

  prevHash String?
  hash      String  @unique

  @@index([complaintId, createdAt])
}

model Media {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id])

  eventId String?
  url     String
  kind    MediaKind
  sha256  String

  lat Float?
  lng Float?

  createdAt DateTime @default(now())

  @@index([complaintId, createdAt])
}

model SLA {
  id       String   @id @default(uuid())
  category Category

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  ackHours     Int
  resolveHours Int

  @@unique([category, departmentId])
}

model Validation {
  id String @id @default(uuid())

  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  vote     Vote
  note     String?
  mediaUrl String?

  isLocal     Boolean  @default(false)
  weight      Int      @default(1) 

  createdAt DateTime @default(now())

  @@unique([complaintId, userId])
}

model PerformanceSnapshot {
  id          String     @id @default(uuid())
  entityType  EntityType
  entityId    String
  periodMonth DateTime 

  totalIssues    Int
  ackP50Min      Int
  ackP95Min      Int
  resolveP50Min  Int
  resolveP95Min  Int
  resolutionRate Int 
  slaBreachRate  Int 

  createdAt DateTime @default(now())

  @@unique([entityType, entityId, periodMonth])
  @@index([entityType, periodMonth])
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([phone, expiresAt])
}